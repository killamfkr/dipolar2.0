<?xml version="1.0"?>
<Container version="2">
  <Name>Dipolar Server</Name>
  <Repository>ghcr.io/killamfkr/dipolar-server:latest</Repository>
  <Registry>https://github.com/killamfkr/dipolar2.0/pkgs/container/dipolar-server</Registry>
  <Network>host</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/killamfkr/dipolar2.0/issues</Support>
  <Project>https://github.com/killamfkr/dipolar2.0</Project>
  <Overview>API server for Dipolar (Streamio IPTV). Uses Host network so it listens on port 3333 on the Unraid host. Run this first, then add the Dipolar App container.</Overview>
  <Category>MediaServer:Other</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon>/plugins/dynamix.docker.manager/images/question.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <Description>API backend for Dipolar. Uses Host network so the API is at Unraid-IP:3333. Image is published to GitHub Container Registry; add the Dipolar App container so the UI can reach this API via host.docker.internal:3333.</Description>
  <Networking>
    <Mode>host</Mode>
    <Publish/>
  </Networking>
  <Environment>
    <Variable>
      <Value>3333</Value>
      <Name>PORT</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>production</Value>
      <Name>NODE_ENV</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="PORT" Target="PORT" Default="3333" Mode="" Description="API port inside container" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
